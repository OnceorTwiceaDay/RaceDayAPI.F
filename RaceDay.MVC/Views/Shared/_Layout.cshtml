<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] | RaceDay</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark race-nav">
    <div class="container">
        <a class="navbar-brand fw-black" asp-controller="Home" asp-action="Index"><span class="brand-mark">R</span> RACEDAY</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navigation" aria-controls="navigation" aria-expanded="false" aria-label="Toggle navigation"><span class="navbar-toggler-icon"></span></button>
        <div id="navigation" class="navbar-collapse collapse">
            <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Find events</a></li>
                @if (Context.Session.GetString("Role") == "Organiser")
                {
                    <li class="nav-item"><a class="nav-link" asp-controller="Organiser" asp-action="Index">Dashboard</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Organiser" asp-action="Create">Create event</a></li>
                }
                @if (Context.Session.GetString("Role") == "Participant")
                {
                    <li class="nav-item"><a class="nav-link" asp-controller="Participant" asp-action="Enrolments">My enrolments</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Participant" asp-action="Results">My results</a></li>
                }
                @if (Context.Session.GetString("ApiCookie") != null)
                {
                    <li class="nav-item"><a class="nav-link" asp-controller="Profile" asp-action="Index">@Context.Session.GetString("FullName")</a></li>
                    <li class="nav-item"><form asp-controller="Account" asp-action="Logout" method="post">@Html.AntiForgeryToken()<button type="submit" class="btn btn-sm btn-outline-light">Logout</button></form></li>
                }
                else
                {
                    <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Login</a></li>
                    <li class="nav-item"><a class="btn btn-accent btn-sm" asp-controller="Account" asp-action="Register">Sign up</a></li>
                }
            </ul>
        </div>
    </div>
</nav>
<main>
    <div class="container mt-3">
        @if (TempData["Success"] != null) { <div class="alert alert-success" role="status">@TempData["Success"]</div> }
        @if (TempData["Error"] != null) { <div class="alert alert-danger" role="alert">@TempData["Error"]</div> }
    </div>
    @RenderBody()
</main>
<footer class="footer"><div class="container d-flex justify-content-between flex-wrap gap-2"><strong>RACEDAY</strong><span>Move further. Finish stronger.</span><span>© @DateTime.UtcNow.Year</span></div></footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@model OrganiserEventViewModel
@{ ViewData["Title"] = "Manage " + Model.Event.EventName; }
<section class="container section"><a asp-action="Index" class="back-link">← Dashboard</a><div class="d-flex flex-wrap justify-content-between align-items-center mt-3 gap-3"><div><p class="eyebrow">EVENT MANAGEMENT</p><h1>@Model.Event.EventName</h1><p class="muted">@Model.Event.Location · @Model.Event.EventDate.ToString("dd MMM yyyy")</p></div><a class="btn btn-outline-dark" asp-action="Edit" asp-route-id="@Model.Event.EventId">Edit event</a></div>
<h2 class="mt-5">Categories</h2><div class="row g-3 mt-2">@foreach (var c in Model.Categories) { <div class="col-md-4"><div class="surface"><h4>@c.CategoryName</h4><p class="muted">@c.DistanceKm km · R @c.EntryFee</p><form asp-action="DeleteCategory" method="post">@Html.AntiForgeryToken()<input type="hidden" name="eventId" value="@Model.Event.EventId" /><input type="hidden" name="categoryId" value="@c.CategoryId" /><button class="btn btn-sm btn-outline-danger">Delete</button></form></div></div> }</div>
<div class="surface mt-4"><h3>Add category</h3><form asp-action="AddCategory" method="post" class="row g-3 mt-1">@Html.AntiForgeryToken()<input type="hidden" name="eventId" value="@Model.Event.EventId" /><div class="col-md-4"><label class="form-label">Name</label><input name="CategoryName" class="form-control" required /></div><div class="col-md-2"><label class="form-label">Distance (km)</label><input name="DistanceKm" type="number" class="form-control" step="0.01" min="0.01" required /></div><div class="col-md-2"><label class="form-label">Minimum age</label><input name="MinAge" type="number" min="0" class="form-control" value="0" required /></div><div class="col-md-2"><label class="form-label">Maximum age</label><input name="MaxAge" type="number" min="0" class="form-control" /></div><div class="col-md-2"><label class="form-label">Entry fee (R)</label><input name="EntryFee" type="number" min="0" step="0.01" class="form-control" value="0" required /></div><div class="col-12"><button class="btn btn-accent">Add category</button></div></form></div>
<h2 class="mt-5">Enrolments (@Model.Enrolments.Count)</h2><div class="table-responsive surface mt-3"><table class="table align-middle mb-0"><thead><tr><th>Participant</th><th>Category</th><th>Payment</th><th>Status</th><th>Update status</th></tr></thead><tbody>
@foreach (var e in Model.Enrolments) { <tr><td>@e.ParticipantName</td><td>@e.CategoryName</td><td>@e.PaymentStatus</td><td><span class="status status-@e.Status.ToLowerInvariant()">@e.Status</span></td><td><form asp-action="SetStatus" method="post" class="d-flex gap-2">@Html.AntiForgeryToken()<input type="hidden" name="eventId" value="@Model.Event.EventId" /><input type="hidden" name="enrolmentId" value="@e.EnrolmentId" /><select name="status" class="form-select form-select-sm"><option selected="@(e.Status == "Pending")">Pending</option><option selected="@(e.Status == "Confirmed")">Confirmed</option><option selected="@(e.Status == "Cancelled")">Cancelled</option></select><button class="btn btn-sm btn-outline-dark">Save</button></form></td></tr> }
</tbody></table>@if (!Model.Enrolments.Any()) { <p class="muted p-3">No enrolments yet.</p> }</div>
<h2 class="mt-5">Capture and publish results</h2><p class="muted">Enter each finisher's time and position. Existing results are updated when resubmitted.</p><div class="surface table-responsive mt-3"><table class="table align-middle mb-0"><thead><tr><th>Entrant</th><th>Category</th><th>Finish time (hh:mm:ss)</th><th>Overall</th><th>Category position</th><th>Status</th><th></th></tr></thead><tbody>
@foreach (var e in Model.Enrolments) { var existing = Model.Results.FirstOrDefault(r => r.EnrolmentId == e.EnrolmentId); var fid = $"result-{e.EnrolmentId}"; <tr><td>@e.ParticipantName</td><td>@e.CategoryName</td><td><input form="@fid" type="text" name="FinishTime" class="form-control form-control-sm" placeholder="01:22:35" value="@existing?.FinishTime" /></td><td><input form="@fid" type="number" min="1" name="FinishPosition" class="form-control form-control-sm" value="@existing?.FinishPosition" /></td><td><input form="@fid" type="number" min="1" name="CategoryPosition" class="form-control form-control-sm" value="@existing?.CategoryPosition" /></td><td><select form="@fid" name="Status" class="form-select form-select-sm"><option selected="@(existing?.Status == "Finished")">Finished</option><option selected="@(existing?.Status == "DNF")">DNF</option><option selected="@(existing?.Status == "DNS")">DNS</option></select></td><td><form id="@fid" asp-action="SaveResult" method="post">@Html.AntiForgeryToken()<input type="hidden" name="EventId" value="@Model.Event.EventId" /><input type="hidden" name="EnrolmentId" value="@e.EnrolmentId" /><button class="btn btn-accent btn-sm">Publish</button></form></td></tr> }
</tbody></table>@if (!Model.Enrolments.Any()) { <p class="muted p-3">No entrants available for result capture.</p> }</div></section>

@model EventFormViewModel
@{ var editing = ViewContext.RouteData.Values["action"]?.ToString() == "Edit"; ViewData["Title"] = editing ? "Edit event" : "Create event"; }
<section class="container section"><a asp-action="Index" class="back-link">← Dashboard</a><p class="eyebrow mt-3">EVENT BUILDER</p><h1>@(editing ? "Edit your event" : "Create a new event")</h1>
<div class="surface form-wide mt-4"><form method="post" enctype="multipart/form-data">@Html.AntiForgeryToken()<div asp-validation-summary="All" class="text-danger"></div>
<div class="row g-3"><div class="col-12"><label asp-for="EventName" class="form-label">Event name</label><input asp-for="EventName" class="form-control" /></div>
<div class="col-12"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="4"></textarea></div>
<div class="col-md-6"><label asp-for="EventDate" class="form-label">Date</label><input asp-for="EventDate" type="date" class="form-control" /></div>
<div class="col-md-6"><label asp-for="Location" class="form-label"></label><input asp-for="Location" class="form-control" /></div>
<div class="col-md-6"><label asp-for="DistanceKm" class="form-label">Distance (km)</label><input asp-for="DistanceKm" class="form-control" type="number" step="0.01" min="0.01" /></div>
<div class="col-md-6"><label asp-for="EventType" class="form-label">Sport</label><select asp-for="EventType" class="form-select"><option>Running</option><option>Walking</option><option>Cycling</option></select></div>
<div class="col-12"><label asp-for="Banner" class="form-label">Event banner (JPG, PNG, WebP · 5 MB maximum)</label><input asp-for="Banner" class="form-control" type="file" accept="image/jpeg,image/png,image/webp" /></div>
</div><button class="btn btn-accent btn-lg mt-4">@(editing ? "Save changes" : "Create event")</button></form></div></section>

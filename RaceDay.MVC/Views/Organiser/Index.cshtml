@model OrganiserDashboardViewModel
@{ ViewData["Title"] = "Organiser dashboard"; }
<section class="container section"><div class="d-flex flex-wrap align-items-center justify-content-between gap-3"><div><p class="eyebrow">ORGANISER CONTROL CENTRE</p><h1>Your events. Your impact.</h1></div><a class="btn btn-accent btn-lg" asp-action="Create">+ Create event</a></div>
<div class="row g-3 my-4"><div class="col-md-4"><div class="surface"><p class="eyebrow">TOTAL EVENTS</p><strong class="stat">@Model.Events.Count</strong></div></div><div class="col-md-4"><div class="surface"><p class="eyebrow">TOTAL ENTRIES</p><strong class="stat">@Model.EntrantsByEvent.Values.Sum()</strong></div></div><div class="col-md-4"><div class="surface"><p class="eyebrow">UPCOMING</p><strong class="stat">@Model.Events.Count(e => e.EventDate >= DateOnly.FromDateTime(DateTime.Today))</strong></div></div></div>
<h2 class="mt-5">Manage events</h2><div class="row g-4 mt-2">
@foreach (var ev in Model.Events.OrderBy(e => e.EventDate)) { <div class="col-lg-6"><div class="surface"><div class="d-flex justify-content-between"><span class="tag">@ev.EventType</span><span class="muted">@ev.EventDate.ToString("dd MMM yyyy")</span></div><h3 class="mt-3">@ev.EventName</h3><p class="muted">@ev.Location · @ev.DistanceKm km</p><p><strong>@Model.EntrantsByEvent.GetValueOrDefault(ev.EventId)</strong> enrolments</p><div class="d-flex flex-wrap gap-2"><a class="btn btn-accent" asp-action="Manage" asp-route-id="@ev.EventId">Manage</a><a class="btn btn-outline-dark" asp-action="Edit" asp-route-id="@ev.EventId">Edit</a><form asp-action="Delete" asp-route-id="@ev.EventId" method="post" onsubmit="return confirm('Delete this event?')">@Html.AntiForgeryToken()<button class="btn btn-outline-danger">Delete</button></form></div></div></div> }
@if (!Model.Events.Any()) { <div class="col"><div class="surface text-center p-5">Create your first RaceDay event to get started.</div></div> }
</div></section>

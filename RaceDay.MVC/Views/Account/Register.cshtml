@model RegisterViewModel
@{ ViewData["Title"] = "Register"; }
<section class="container section"><div class="auth-card surface"><p class="eyebrow">JOIN THE MOVEMENT</p><h1>Create your account</h1>
<form asp-action="Register" method="post">@Html.AntiForgeryToken()<div asp-validation-summary="All" class="text-danger"></div>
<label asp-for="FullName" class="form-label">Full name</label><input asp-for="FullName" class="form-control mb-3" />
<label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control mb-3" autocomplete="email" />
<label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control mb-3" autocomplete="new-password" />
<label asp-for="Role" class="form-label">I want to</label><select asp-for="Role" class="form-select mb-4"><option value="Participant">Participate in events</option><option value="Organiser">Organise events</option></select>
<button class="btn btn-accent w-100">Create account</button></form>
<p class="mt-3">Already registered? <a asp-action="Login">Sign in</a></p></div></section>

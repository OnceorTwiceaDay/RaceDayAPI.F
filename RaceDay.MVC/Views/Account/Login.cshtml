@model LoginViewModel
@{ ViewData["Title"] = "Login"; }
<section class="container section"><div class="auth-card surface"><p class="eyebrow">WELCOME BACK</p><h1>Ready for your next race?</h1><p class="muted">Sign in to manage your RaceDay journey.</p>
<form asp-action="Login" method="post">@Html.AntiForgeryToken()<div asp-validation-summary="All" class="text-danger"></div>
<label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control mb-3" autocomplete="email" />
<label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control mb-4" autocomplete="current-password" />
<button class="btn btn-accent w-100" type="submit">Sign in</button></form>
<p class="mt-3">New here? <a asp-action="Register">Create an account</a></p></div></section>

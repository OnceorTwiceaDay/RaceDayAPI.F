@model List<EnrolmentDto>
@{ ViewData["Title"] = "My enrolments"; }
<section class="container section"><p class="eyebrow">YOUR RACE CALENDAR</p><h1>My enrolments</h1><div class="table-responsive surface mt-4"><table class="table align-middle mb-0"><thead><tr><th>Event</th><th>Category</th><th>Status</th><th>Payment</th><th></th></tr></thead><tbody>@foreach (var item in Model) { <tr><td><a asp-controller="Home" asp-action="Details" asp-route-id="@item.EventId">@item.EventName</a></td><td>@item.CategoryName</td><td><span class="status status-@item.Status.ToLowerInvariant()">@item.Status</span></td><td>@item.PaymentStatus</td><td><form asp-action="Cancel" asp-route-id="@item.EnrolmentId" method="post" onsubmit="return confirm('Cancel this enrolment?')">@Html.AntiForgeryToken()<button class="btn btn-sm btn-outline-danger">Cancel</button></form></td></tr> }</tbody></table>@if (!Model.Any()) { <p class="p-4 muted">No entries yet. <a asp-controller="Home" asp-action="Index">Find an event</a>.</p> }</div></section>

@model ParticipantResultsViewModel
@{
    ViewData["Title"] = "My results";
}
<section class="container section">
    <p class="eyebrow">EVERY FINISH COUNTS</p>
    <h1>My results</h1>
    <div class="row g-4 mt-2">
        @foreach (var result in Model.Results.OrderByDescending(r => r.EventDate))
        {
            var totalFinishers = Model.RecordedFinishersByEvent.GetValueOrDefault(result.EventId);
            <div class="col-md-6">
                <article class="surface h-100">
                    <span class="tag">@result.Status</span>
                    <h3 class="mt-3">@result.EventName</h3>
                    <p class="muted">@result.EventDate.ToString("dd MMM yyyy") · @result.CategoryName</p>
                    <div class="d-flex gap-4 flex-wrap">
                        <div>
                            <p class="eyebrow mb-1">FINISH TIME</p>
                            <strong class="stat">@(result.FinishTime?.ToString() ?? "—")</strong>
                        </div>
                        <div>
                            <p class="eyebrow mb-1">OVERALL</p>
                            <strong class="stat">@(result.FinishPosition?.ToString() ?? "—")</strong>
                            @if (totalFinishers > 0)
                            {
                                <p class="muted small mb-0">of @totalFinishers published finishers</p>
                            }
                        </div>
                        <div>
                            <p class="eyebrow mb-1">CATEGORY POSITION</p>
                            <strong class="stat">@(result.CategoryPosition?.ToString() ?? "—")</strong>
                        </div>
                    </div>
                </article>
            </div>
        }
        @if (!Model.Results.Any())
        {
            <div class="col">
                <div class="surface">
                    Your race results will appear here after the organiser publishes them.
                </div>
            </div>
        }
    </div>
</section>

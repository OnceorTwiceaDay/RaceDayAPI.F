@model List<ResultDto>
@{ ViewData["Title"] = "My results"; }
<section class="container section"><p class="eyebrow">EVERY FINISH COUNTS</p><h1>My results</h1><div class="row g-4 mt-2">@foreach (var result in Model.OrderByDescending(r => r.EventDate)) { <div class="col-md-6"><div class="surface"><span class="tag">@result.Status</span><h3 class="mt-3">@result.EventName</h3><p class="muted">@result.EventDate.ToString("dd MMM yyyy") · @result.CategoryName</p><div class="d-flex gap-4"><div><div class="eyebrow">FINISH TIME</div><strong class="stat">@result.FinishTime?.ToString()</strong></div><div><div class="eyebrow">OVERALL POSITION</div><strong class="stat">@(result.FinishPosition?.ToString() ?? "—")</strong></div><div><div class="eyebrow">CATEGORY</div><strong class="stat">@(result.CategoryPosition?.ToString() ?? "—")</strong></div></div></div></div> }@if (!Model.Any()) { <div class="col"><div class="surface">Your race results will appear here after your organiser publishes them.</div></div> }</div></section>

@model List<EventDto>
@{ ViewData["Title"] = "Find your next event"; }
<section class="hero"><div class="container py-5"><p class="eyebrow">SOUTH AFRICAN RUNNING • WALKING • CYCLING</p><h1>THE START LINE<br /><span>IS YOURS.</span></h1><p>Discover an event, join a category, and chase your personal best.</p><a href="#events" class="btn btn-accent btn-lg">Explore events →</a></div></section>
<section id="events" class="container section"><div class="d-flex justify-content-between flex-wrap align-items-end gap-3 mb-4"><div><p class="eyebrow">THE EVENT CALENDAR</p><h2>Find your next challenge</h2></div><div class="text-secondary">@Model.Count events found</div></div>
<form method="get" asp-action="Index" class="surface filter-form row g-3 mb-4"><div class="col-lg-6"><label for="search" class="form-label">Search events or locations</label><input id="search" name="search" class="form-control" value="@ViewBag.Search" placeholder="e.g. Pretoria" /></div><div class="col-lg-4"><label for="type" class="form-label">Sport</label><select id="type" name="type" class="form-select"><option value="">All sports</option>@foreach (var type in new[] { "Running", "Walking", "Cycling" }) { <option value="@type" selected="@(ViewBag.SelectedType == type ? "selected" : null)">@type</option> }</select></div><div class="col-lg-2 d-flex align-items-end"><button class="btn btn-accent w-100">Filter</button></div></form>
<div class="row g-4">
@foreach (var ev in Model)
{
    <div class="col-md-6 col-lg-4"><article class="event-card h-100">
        @if (MediaUrls.ForMvc(ev.BannerImageUrl) is string img) { <img src="@img" alt="Banner for @ev.EventName" class="event-image" /> }
        else { <div class="event-placeholder"><span>@(ev.EventType == "Cycling" ? "🚴" : ev.EventType == "Walking" ? "🚶" : "🏃")</span></div> }
        <div class="p-4"><div class="d-flex justify-content-between gap-2"><span class="tag">@ev.EventType</span><span class="muted">@ev.EventDate.ToString("dd MMM yyyy")</span></div><h3 class="mt-3">@ev.EventName</h3><p class="muted">📍 @ev.Location</p><div class="d-flex justify-content-between align-items-center"><strong>@ev.DistanceKm km</strong><a class="btn btn-sm btn-outline-dark" asp-action="Details" asp-route-id="@ev.EventId">View event →</a></div></div>
    </article></div>
}
@if (Model.Count == 0) { <div class="col-12"><div class="surface text-center p-5">No matching events found. Try another sport or location.</div></div> }
</div></section>

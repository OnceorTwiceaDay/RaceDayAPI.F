@model EventDetailsViewModel
@{ ViewData["Title"] = Model.Event.EventName; }
<section class="container section">
<a asp-action="Index" class="back-link">← All events</a>
<div class="row g-4 mt-2"><div class="col-lg-8">
@if (MediaUrls.ForMvc(Model.Event.BannerImageUrl) is string img) { <img src="@img" alt="@Model.Event.EventName" class="details-banner" /> }
<p class="eyebrow mt-4">@Model.Event.EventType • @Model.Event.DistanceKm km</p><h1>@Model.Event.EventName</h1><p class="lead">@Model.Event.Description</p>
<h3 class="mt-5">Choose your category</h3><div class="row g-3">
@foreach (var cat in Model.Categories) { <div class="col-md-6"><div class="surface h-100"><h4>@cat.CategoryName</h4><p class="muted">@cat.DistanceKm km · Age @cat.MinAge+ @((cat.MaxAge.HasValue) ? $"to {cat.MaxAge}" : "")</p><p><strong>R @cat.EntryFee.ToString("0.00")</strong></p>
@if (Context.Session.GetString("Role") == "Participant") { <form asp-controller="Participant" asp-action="Enrol" method="post">@Html.AntiForgeryToken()<input type="hidden" name="eventId" value="@Model.Event.EventId" /><input type="hidden" name="categoryId" value="@cat.CategoryId" /><button class="btn btn-accent">Enter category</button></form> }
else if (Context.Session.GetString("ApiCookie") == null) { <a class="btn btn-outline-dark" asp-controller="Account" asp-action="Login">Log in to enter</a> }
</div></div> }
@if (!Model.Categories.Any()) { <p class="muted">Categories will be announced soon.</p> }
</div>
@if (Model.Routes.Any()) { <h3 class="mt-5">Routes</h3>@foreach (var route in Model.Routes) { <div class="surface mb-2"><strong>@route.RouteName</strong> · @route.DistanceKm km <span class="muted">(@route.StartPoint → @route.EndPoint)</span></div> } }
<h3 class="mt-5">Leaderboard</h3><div class="table-responsive surface"><table class="table align-middle mb-0"><thead><tr><th>Position</th><th>Participant</th><th>Time</th><th>Status</th></tr></thead><tbody>@foreach (var r in Model.Results) { <tr><td>@(r.FinishPosition?.ToString() ?? "—")</td><td>@r.ParticipantName</td><td>@(r.FinishTime?.ToString() ?? "—")</td><td>@r.Status</td></tr> }</tbody></table>@if (!Model.Results.Any()) { <p class="muted p-3">Results not published yet.</p> }</div>
</div><aside class="col-lg-4"><div class="surface sticky-top event-aside"><h3>Event details</h3><dl class="row mt-4"><dt class="col-4">Date</dt><dd class="col-8">@Model.Event.EventDate.ToString("dddd, dd MMM yyyy")</dd><dt class="col-4">Location</dt><dd class="col-8">@Model.Event.Location</dd><dt class="col-4">Sport</dt><dd class="col-8">@Model.Event.EventType</dd><dt class="col-4">Distance</dt><dd class="col-8">@Model.Event.DistanceKm km</dd><dt class="col-4">Organiser</dt><dd class="col-8">@Model.Event.OrganiserName</dd></dl></div></aside></div></section>
